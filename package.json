{
  "name": "kaiwaai",
  "version": "1.6.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "predev": "node scripts/write-app-version-env.mjs && prisma generate --schema prisma/schema.prisma",
    "prebuild": "node scripts/write-app-version-env.mjs && prisma generate --schema prisma/schema.prisma",
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "npm run lint && npm run typecheck && npm run test",
    "import:dictionary": "npx tsx scripts/import-dictionary.ts",
    "regenerate:words": "node scripts/regenerate-word-csvs.mjs",
    "restore:flashcards": "npx tsx scripts/restore-flashcards.ts",
    "migrate:phrases": "npx tsx scripts/migrate-to-phrases.ts",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:run:android": "npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-updater": "^8.51.3",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.0.0",
    "jose": "^6.2.3",
    "next": "16.2.9",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.9",
    "better-sqlite3": "^12.11.1",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
