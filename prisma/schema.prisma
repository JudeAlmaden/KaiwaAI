// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Note: connection URL is provided at runtime via the pg adapter (src/lib/prisma.ts).
// Prisma Migrate reads DATABASE_URL / DIRECT_URL from prisma.config.ts.

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  password           String
  timezone           String    @default("UTC")
  // Opt-in: user's Gemini API key, encrypted at rest (AES-256-GCM). Enables
  // server-side features (scheduled messages, background summaries). Null = the
  // key stays client-side only (default BYOK behavior).
  geminiKeyEnc       String?
  // learning prefs
  maxNewWords        Int       @default(1)
  level              String    @default("N5")
  // ── Kai outreach ("messages first") ──
  outreachMode       String    @default("off") // off | scheduled | random
  outreachTimes      String    @default("[]") // JSON "HH:MM"[] for scheduled mode
  quietStart         Int       @default(22) // hour (0-23) — no pings at/after
  quietEnd           Int       @default(8) // hour (0-23) — no pings before
  consecutiveIgnored Int       @default(0) // outreach streak with no return
  lastOutreachAt     DateTime? // when Kai last reached out
  lastActiveAt       DateTime? // when the user last chatted/opened
  // ── Streak ──
  streakCount        Int       @default(0) // consecutive active days
  streakBestCount    Int       @default(0) // longest streak achieved
  lastStreakDay      String? // dayKey of the last counted active day
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memories       Memory[]
  kanjiMnemonics KanjiMnemonic[]
  userKanji      UserKanji[]

  // ── Social: friends, chats, personas ──
  personas               Persona[]
  ownedChats             Chat[]       @relation("ChatOwner")
  chatMemberships        ChatMember[]
  messages               Message[]
  friendRequestsSent     Friendship[] @relation("FriendRequester")
  friendRequestsReceived Friendship[] @relation("FriendAddressee")

  // ── Dictionary: new flashcard system ──
  userFlashcards UserFlashcard[]
  phrases        Phrase[]

  // ── Push notifications ──
  pushSubscriptions PushSubscription[]
}

// A reusable AI character. Kai ships as a built-in (seeded with a null userId);
// users can also create their own personas to drop into group chats.
model Persona {
  id     String  @id @default(cuid())
  // Null userId = built-in/global persona (e.g. Kai). Otherwise the creator.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  // Short tagline shown in pickers, e.g. "Cheerful Japanese tutor".
  blurb       String  @default("")
  // The persona's voice/role — injected into the system prompt.
  personality String
  avatar      String  @default("🤖") // emoji avatar for now
  builtin     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatMembers ChatMember[]
  memories    Memory[]

  @@index([userId])
}

// Symmetric friendship modeled as a directed request that gets accepted.
model Friendship {
  id          String @id @default(cuid())
  requesterId String
  requester   User   @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User   @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  status String @default("pending") // pending | accepted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// A conversation. `kind` distinguishes a 1:1 persona chat, a user↔user DM, and
// a multi-person group. AI-containing conversations get the rich learning
// features (tokens/english/correction). The owner provides the API key.
model Chat {
  id      String @id @default(cuid())
  name    String
  kind    String @default("group") // "persona" | "dm" | "group"
  ownerId String
  owner   User   @relation("ChatOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Owner's Gemini key(s) for this conversation, encrypted at rest
  // (AES-256-GCM). JSON array of keys. Null = no AI replies.
  apiKeyEnc String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ChatMember[]
  messages Message[]

  @@index([ownerId])
}

// A participant in a group: either a human user OR an AI persona.
model ChatMember {
  id     String @id @default(cuid())
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  // Exactly one of userId / personaId is set (kind disambiguates).
  kind      String // "user" | "persona"
  // Invite state for human members. Personas are always "accepted".
  // The group owner is auto-accepted on creation.
  status    String   @default("accepted") // pending | accepted
  // Whether this member has hidden the conversation from their chat list
  hidden    Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  personaId String?
  persona   Persona? @relation(fields: [personaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  messages Message[]

  @@unique([chatId, userId])
  @@unique([chatId, personaId])
  @@index([chatId])
}

model Message {
  id     String @id @default(cuid())
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  // The author. senderUserId set for humans, senderPersonaId for AI.
  memberId     String?
  member       ChatMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  senderUserId String?
  senderUser   User?       @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  senderName   String // denormalized display name (human name or persona name)
  senderKind   String // "user" | "persona"

  content        String
  // Rich learning fields, populated for AI (persona) messages — same as Kai's
  // 1:1 chat. JSON strings; null for human messages.
  english        String?
  tokens         String?
  correction     String?
  // AI grammar correction for user's Japanese messages (JSON string). Generated
  // client-side when user sends Japanese text.
  userCorrection String?
  createdAt      DateTime @default(now())

  @@index([chatId, createdAt])
}

model Memory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Which persona this memory belongs to (scoped per user). Null = Kai, the
  // default tutor (preserves pre-persona memories without migration).
  personaId String?
  persona   Persona? @relation(fields: [personaId], references: [id], onDelete: Cascade)

  content      String
  category     String  @default("fact") // profile | preference | fact | goal | relationship
  importance   Int     @default(1) // 1..5
  sourceDayKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, category])
  @@index([userId, personaId])
}

// User's kanji learning progress with SRS
model UserKanji {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kanjiId String
  kanji   Kanji  @relation(fields: [kanjiId], references: [id], onDelete: Cascade)

  // SRS (SM-2). Same as Flashcard
  status         String    @default("new") // new | learning | known
  easeFactor     Float     @default(2.5)
  interval       Int       @default(0)
  repetitions    Int       @default(0)
  timesReviewed  Int       @default(0)
  nextReview     DateTime  @default(now())
  lastReviewedAt DateTime?

  // User's custom mnemonic for remembering this kanji
  mnemonic String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kanjiId])
  @@index([userId, status])
  @@index([userId, nextReview])
}

// Kanji character information seeded from kanji-data.json
model Kanji {
  id          String   @id @default(cuid())
  character   String   @unique // The kanji itself, e.g., "勝"
  strokes     Int // Stroke count
  grade       Int? // School grade level (1-6 for kyouiku)
  frequency   Int? // Usage frequency rank (lower = more common)
  jlptLevel   Int? // JLPT level: 5=N5, 4=N4, 3=N3, 2=N2, 1=N1
  meanings    String // JSON array: ["Victory", "Win"]
  readingsOn  String // JSON array: ["しょう"]
  readingsKun String // JSON array: ["か.つ", "まさ.る"]
  radicals    String // JSON array: ["Moon", "Gladiator", "Power"]
  wkLevel     Int? // WaniKani level (1-60)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mnemonics KanjiMnemonic[]
  userKanji UserKanji[]

  @@index([jlptLevel])
  @@index([grade])
  @@index([frequency])
  @@index([character])
}

// User-specific AI-generated mnemonics for kanji
model KanjiMnemonic {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kanjiId   String
  kanji     Kanji    @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  mnemonic  String // AI-generated story
  createdAt DateTime @default(now())

  @@unique([userId, kanjiId])
  @@index([userId])
  @@index([kanjiId])
}

// ════════════════════════════════════════════════════════════════════════════
// Dictionary & Vocabulary System
// ════════════════════════════════════════════════════════════════════════════

enum PartOfSpeech {
  noun
  verb
  adjective
  adverb
  particle
  conjunction
  interjection
  expression
  phrase
  pronoun
  counter
  suffix
  prefix
  auxiliary
  copula
  unclassified
}

enum VerbType {
  godan
  ichidan
  suru
  kuru
  irregular
}

enum AdjectiveType {
  i_adjective
  na_adjective
}

enum FlashcardStatus {
  new
  learning
  known
}

// Base dictionary word (lemma/citation form)
model Word {
  id            Int            @id // Use CSV integer IDs directly
  dictionary    String         @unique // 飲む
  reading       String // のむ
  meanings      String // JSON array ["to drink", "to swallow"]
  partOfSpeech  PartOfSpeech
  verbType      VerbType?
  adjectiveType AdjectiveType?
  jlptLevel     String? // N5, N4, N3, N2, N1
  frequency     Int? // Raw frequency rank (lower = more common)
  aiGenerated   Boolean @default(false) // true = inserted by AI fallback, not JMdict

  createdAt DateTime @default(now())

  forms          WordForm[]
  userFlashcards UserFlashcard[]

  @@index([dictionary])
  @@index([reading])
  @@index([jlptLevel, frequency])
  @@index([partOfSpeech])
  @@index([frequency])
}

// Conjugated/inflected word forms
model WordForm {
  id     String @id @default(cuid())
  wordId Int // Integer foreign key to match Word.id
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  form     String // 飲みます
  reading  String // のみます
  formType String // "masu", "te", "plain_negative", etc.

  generated Boolean @default(true) // true = auto-generated, false = manual/irregular

  userFlashcards UserFlashcard[]

  @@unique([wordId, formType])
  @@index([form])
  @@index([reading])
  @@index([wordId])
  @@index([formType])
}

// User's flashcard for studying (can be base word OR specific conjugation OR custom phrase)
model UserFlashcard {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Either a dictionary word OR a custom phrase (exactly one must be set)
  wordId Int?
  word   Word?   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  phraseId String?
  phrase   Phrase? @relation(fields: [phraseId], references: [id], onDelete: Cascade)

  // Optional: specific form being studied (only applies to wordId, null for phrases)
  wordFormId String?
  wordForm   WordForm? @relation(fields: [wordFormId], references: [id], onDelete: SetNull)

  status         FlashcardStatus @default(new)
  easeFactor     Float           @default(2.5)
  interval       Int             @default(0)
  repetitions    Int             @default(0)
  timesReviewed  Int             @default(0)
  exposures      Int             @default(0)
  nextReview     DateTime        @default(now())
  lastReviewedAt DateTime?

  note      String? // User's personal notes
  createdAt DateTime @default(now())

  @@unique([userId, wordFormId]) // One flashcard per form
  @@unique([userId, phraseId]) // One flashcard per phrase
  @@index([userId, status])
  @@index([userId, nextReview])
  @@index([wordId])
  @@index([phraseId])
}

// AI-generated or user-created custom phrases
model Phrase {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The phrase itself
  text     String // 今日はいい天気ですね
  reading  String // きょうはいいてんきですね
  meanings String // JSON array ["Today's weather is nice, isn't it?"]

  // Metadata
  partOfSpeech PartOfSpeech @default(phrase)
  
  // Source tracking
  source   String  @default("ai_chat") // "ai_chat", "ai_lookup", "user_created"
  sourceId String? // Chat message ID or conversation ID
  context  String? // Conversation snippet where it appeared

  // Quality/Review
  verified Boolean @default(false) // User confirmed it's correct
  reviewed Boolean @default(false) // User has seen/reviewed it

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userFlashcards UserFlashcard[]

  @@unique([userId, text]) // User can't have duplicate phrases
  @@index([userId])
  @@index([text])
  @@index([userId, verified])
}

// Web Push subscription for a user's device.
// One user may have multiple devices (phone + laptop etc.).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String   @unique // the browser's push endpoint URL
  p256dh    String   // client public key (base64url)
  auth      String   // auth secret (base64url)

  createdAt DateTime @default(now())

  @@index([userId])
}
