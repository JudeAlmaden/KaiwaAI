// New Dictionary Schema - Generated 2026-07-08T16:25:43.847Z

model Word {
  id              String   @id @default(cuid())
  dictionary      String   @unique
  reading         String
  meanings        String   // JSON array
  partOfSpeech    String
  verbType        String?
  jlptLevel       String?
  frequencyBucket Int
  
  forms           WordForm[]
  userFlashcards  UserFlashcard[]
  
  @@index([dictionary])
  @@index([jlptLevel, frequencyBucket])
  @@index([partOfSpeech])
}

model WordForm {
  id        String   @id @default(cuid())
  wordId    String
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  
  form      String
  reading   String
  formType  String
  
  userFlashcards UserFlashcard[]
  
  @@unique([wordId, formType])
  @@index([form])
}

model UserFlashcard {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  wordId       String
  word         Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  
  wordFormId   String?
  wordForm     WordForm? @relation(fields: [wordFormId], references: [id], onDelete: SetNull)
  
  status         String   @default("new")
  easeFactor     Float    @default(2.5)
  interval       Int      @default(0)
  repetitions    Int      @default(0)
  timesReviewed  Int      @default(0)
  exposures      Int      @default(0)
  nextReview     DateTime @default(now())
  lastReviewedAt DateTime?
  
  note           String?
  createdAt      DateTime @default(now())
  
  @@unique([userId, wordId])
  @@index([userId, status])
  @@index([userId, nextReview])
}
